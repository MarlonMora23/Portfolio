---
import Section from "@/components/Section.astro";
import { getI18n } from "@/i18n";

const { currentLocale } = Astro;
const i18n = getI18n({ currentLocale });

const skillGroups = [
    {
        label: i18n.SKILLS.GROUP_ML,
        emoji: "🤖",
        skills: ["Python", "TensorFlow", "Keras", "pandas", "NumPy", "scikit-learn", "Jupyter"],
    },
    {
        label: i18n.SKILLS.GROUP_BACKEND,
        emoji: "⚙️",
        skills: ["Flask", "SQLAlchemy", "PostgreSQL", "REST APIs"],
    },
    {
        label: i18n.SKILLS.GROUP_FRONTEND,
        emoji: "🎨",
        skills: ["React", "Angular", "TailwindCSS", "TypeScript", "Vite", "Astro", "JavaScript", "HTML/CSS"],
    },
    {
        label: i18n.SKILLS.GROUP_DEVOPS,
        emoji: "🚀",
        skills: ["Git", "Github", "Docker", "Linux"],
    },
];
---

<Section id="about" class="about-section">

    <!-- OVERLINE -->
    <p class="about-overline scroll-reveal">
        {i18n.ABOUT.TITLE}
    </p>

    <!-- STATEMENT -->
    <h2 class="about-statement scroll-reveal" style="--delay: 0.1s">
        {i18n.ABOUT.STATEMENT}
    </h2>

    <!-- BODY -->
    <div class="about-body scroll-reveal" style="--delay: 0.2s">

        <div class="about-col">
            <div class="about-col-label">{i18n.ABOUT.COL_ACADEMIC_LABEL}</div>
            <p class="about-text">{i18n.ABOUT.PARAGRAPH1}</p>
            <br>
            <p class="about-text">{i18n.ABOUT.PARAGRAPH2}</p>
        </div>

        <div class="about-col">
            <div class="about-col-label">{i18n.ABOUT.COL_HIGHLIGHTS_LABEL}</div>

            <div class="about-highlights">

                <div class="highlight-card scroll-reveal" style="--delay: 0.3s">
                    <span class="highlight-icon">🎓</span>
                    <div>
                        <div class="highlight-title">{i18n.ABOUT.HIGHLIGHT_1_TITLE}</div>
                        <div class="highlight-desc">{i18n.ABOUT.HIGHLIGHT_1_DESC}</div>
                    </div>
                </div>

                <div class="highlight-card scroll-reveal" style="--delay: 0.4s">
                    <span class="highlight-icon">💻</span>
                    <div>
                        <div class="highlight-title">{i18n.ABOUT.HIGHLIGHT_2_TITLE}</div>
                        <div class="highlight-desc">{i18n.ABOUT.HIGHLIGHT_2_DESC}</div>
                    </div>
                </div>

                <div class="highlight-card scroll-reveal" style="--delay: 0.5s">
                    <span class="highlight-icon">🧠</span>
                    <div>
                        <div class="highlight-title">{i18n.ABOUT.HIGHLIGHT_3_TITLE}</div>
                        <div class="highlight-desc">{i18n.ABOUT.HIGHLIGHT_3_DESC}</div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- SKILLS (INTEGRATED) -->
    <div class="about-skills scroll-reveal" style="--delay: 0.35s">

        <div class="about-skills-header">
            <p class="about-overline">Skills & Technologies</p>
            <h3 class="about-skills-title">
                Tools I use to turn ideas into systems
            </h3>
        </div>

        <div class="skills-grid">
            {skillGroups.map((group, i) => (
                <div class="skill-group scroll-reveal" style={`--delay: ${0.4 + i * 0.08}s`}>

                    <div class="skill-group-header">
                        <span class="skill-group-label">
                            {group.emoji} {group.label}
                        </span>
                    </div>

                    <div class="skill-tags">
                        {group.skills.map(skill => (
                            <span class="skill-tag">{skill}</span>
                        ))}
                    </div>

                </div>
            ))}
        </div>

    </div>

</Section>

<style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,400&display=swap');

:global(.about-section) {
    background: #F7F7F5;
}

/* OVERLINE */
.about-overline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #1867ce;
    margin-bottom: 20px;
}

.about-overline::before {
    content: '';
    width: 20px;
    height: 2px;
    background: #1867ce;
}

/* STATEMENT */
.about-statement {
    font-family: 'Playfair Display', serif;
    font-size: clamp(24px, 3.5vw, 40px);
    font-style: italic;
    color: #2C2C2A;
    line-height: 1.3;
    max-width: 760px;
    margin-bottom: 56px;
    border-left: 3px solid #004aad;
    padding-left: 24px;
}

/* BODY */
.about-body {
    display: grid;
    gap: 48px;
    margin-bottom: 72px;
}

@media (min-width: 1024px) {
    .about-body {
        grid-template-columns: 1fr 1fr;
        gap: 64px;
    }
}

.about-col-label {
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #B4B2A9;
    margin-bottom: 16px;
}

.about-text {
    font-size: 15px;
    line-height: 1.8;
    color: #5F5E5A;
}

/* HIGHLIGHTS */
.about-highlights {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.highlight-card {
    display: flex;
    gap: 14px;
    background: #fff;
    border: 0.5px solid #E8E6E0;
    border-radius: 10px;
    padding: 16px 18px;
    transition: transform 0.2s ease, border-color 0.2s ease;
}

.highlight-card:hover {
    transform: translateX(6px);
    border-color: #B5D4F4;
}

.highlight-icon {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    background: #E6F1FB;
    border-radius: 8px;
    font-size: 16px;
}

.highlight-title {
    font-size: 14px;
    font-weight: 600;
    color: #2C2C2A;
}

.highlight-desc {
    font-size: 13px;
    color: #888780;
}

/* SKILLS BLOCK */
.about-skills {
    margin-top: 40px;
    padding-top: 40px;
    border-top: 0.5px solid #E8E6E0;
}

.about-skills-title {
    font-size: 18px;
    font-weight: 600;
    color: #2C2C2A;
    margin-bottom: 32px;
}

/* GRID */
.skills-grid {
    display: grid;
    gap: 16px;
}

@media (min-width: 640px) {
    .skills-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (min-width: 1024px) {
    .skills-grid {
        grid-template-columns: repeat(4, 1fr);
    }
}

/* SKILL GROUP */
.skill-group {
    background: #fff;
    border: 0.5px solid #E8E6E0;
    border-radius: 12px;
    padding: 18px;
    transition: transform 0.25s ease, border-color 0.25s ease;
    position: relative;
    overflow: hidden;
}

.skill-group::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.3s;
}

.skill-group:hover::after {
    opacity: 1;
}

.skill-group:hover {
    transform: translateY(-3px);
    border-color: #B5D4F4;
}

.skill-group-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #2C2C2A;
}

/* TAGS */
.skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 10px;
}

.skill-tag {
    font-family: var(--font-mono, monospace);
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 6px;
    background: #E6F1FB;
    color: #0C447C;
    border: 0.5px solid #B5D4F4;
    transition: all 0.2s;
}

.skill-tag:hover {
    background: #004aad;
    color: #fff;
}

/* SCROLL */
.scroll-reveal {
    opacity: 0;
    transform: translateY(20px);
    transition-property: opacity, transform;
    transition-duration: 0.6s;
    transition-timing-function: ease;
    transition-delay: var(--delay, 0s);
}

.scroll-reveal.visible {
    opacity: 1;
    transform: translateY(0);
}
</style>

<script>
const elements = document.querySelectorAll('#about .scroll-reveal');

const observer = new IntersectionObserver(
    entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
            }
        });
    },
    { threshold: 0.12 }
);

elements.forEach(el => observer.observe(el));
</script>