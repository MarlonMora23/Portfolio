---
import { getI18n } from "@/i18n";

const { currentLocale } = Astro;
const i18n = getI18n({ currentLocale });
---

<div class="stats-bridge reveal" aria-label="Estadísticas">
  <div class="stats-bridge-inner">
    <div class="bridge-stat">
      <span class="text-stats-number bridge-number">10+</span>
      <span class="text-label bridge-label">{i18n.HERO.STAT_1_LABEL}</span>
    </div>

    <div class="bridge-divider" aria-hidden="true"></div>

    <div class="bridge-stat">
      <span class="text-stats-number bridge-number">5+</span>
      <span class="text-label bridge-label">{i18n.HERO.STAT_2_LABEL}</span>
    </div>

    <div class="bridge-divider" aria-hidden="true"></div>

    <div class="bridge-stat">
      <span class="text-stats-number bridge-number">50+</span>
      <span class="text-label bridge-label">{i18n.HERO.STAT_3_LABEL}</span>
    </div>

    <div class="bridge-divider" aria-hidden="true"></div>

    <div class="bridge-stat">
      <span class="text-stats-number bridge-number">350+</span>
      <span class="text-label bridge-label">{i18n.HERO.STAT_4_LABEL}</span>
    </div>
  </div>
</div>

<style>
  .stats-bridge {
    width: 100%;
    background: var(--color-bg-white);
    border-top: var(--border-thin) solid var(--color-border-light);
    border-bottom: var(--border-thin) solid var(--color-border-light);
    position: relative;
    z-index: 2;
  }

  .stats-bridge-inner {
    display: grid;
    grid-template-columns: repeat(2, 1fr); /* 👈 mobile: 2x2 */
    gap: var(--spacing-lg);
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-lg);
  }

  /* Tablet */
  @media (min-width: 640px) {
    .stats-bridge-inner {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .stats-bridge-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 var(--spacing-5xl);
    }
  }

  .bridge-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-lg);
    text-align: center;
  }

  /* Desktop spacing más aireado */
  @media (min-width: 1024px) {
    .bridge-stat {
      padding: var(--spacing-xl) var(--spacing-3xl);
      flex: 0 0 auto;
    }
  }

  /* Tipografía responsive */
  .bridge-number {
    color: var(--color-primary-dark);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
  }

  /* Divider solo en desktop */
  .bridge-divider {
    display: none;
  }

  @media (min-width: 1024px) {
    .bridge-divider {
      display: block;
      width: var(--border-thin);
      height: 36px;
      background: var(--color-border-light);
      flex-shrink: 0;
    }
  }
</style>

<script>
  const bridge = document.querySelector(".stats-bridge");
  if (bridge) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          bridge.classList.add("visible");
          observer.disconnect();
        }
      },
      { threshold: 0.2 },
    );
    observer.observe(bridge);
  }
</script>
