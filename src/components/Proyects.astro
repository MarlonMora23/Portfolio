---
import Section from "@/components/Section.astro";
import { projects as baseProjects } from "@/data/projects";
import { getI18n } from "@/i18n";
import { getProjectById } from "@/i18n/helpers";

const { currentLocale } = Astro;
const i18n = getI18n({ currentLocale });

const i18nProjects = i18n.PROYECTS?.items || [];

const getProjectData = (projectId: string) => {
  return getProjectById(i18nProjects, projectId);
};

const projects = baseProjects.map((p) => ({
  ...p,
  title: getProjectData(p.id)?.title || "",
  subtitle: getProjectData(p.id)?.subtitle || "",
  description: getProjectData(p.id)?.description || "",
  role: getProjectData(p.id)?.role || null,
  problem: getProjectData(p.id)?.problem || null,
  features: getProjectData(p.id)?.features || [],
}));

const featuredProjects = projects.filter((p) => p.featured);
const secondaryProjects = projects.filter((p) => !p.featured);

const statusConfig = {
  completed: {
    label: i18n.COMMON?.STATUS_COMPLETED || "Completed",
    dot: "#22c55e",
  },
  "in-progress": {
    label: i18n.COMMON?.STATUS_IN_PROGRESS || "In progress",
    dot: "#f59e0b",
  },
  maintenance: {
    label: i18n.COMMON?.STATUS_MAINTENANCE || "Maintenance",
    dot: "#3b82f6",
  },
};
---

<Section id="proyects" class="proyects-section">
  <p class="section-overline">{i18n.PROYECTS.OVERLINE}</p>
  <h2 class="statement-small">{i18n.PROYECTS.TITLE}</h2>

  <!-- ── FEATURED GRID ─────────────────────────────────────────────── -->
  <div class="projects-grid projects-grid--featured">
    {
      featuredProjects.map((p, i) => {
        const st = statusConfig[p.status];
        return (
          <article
            class="project-card project-card--featured scroll-reveal"
            style={`--delay: ${0.1 + i * 0.12}s`}
          >
            <div
              class="project-img-wrap"
              data-project-id={p.id}
              role="button"
              tabindex="0"
              aria-label={`Ver detalles de ${p.title}`}
            >
              <img
                src={p.image}
                alt={p.imageAlt}
                class="project-img"
              />
              <div class="project-overlay" aria-hidden="true">
                <span class="overlay-cta">{i18n.PROYECTS.VIEW_DETAILS} →</span>
              </div>
            </div>

            <div class="project-body">
              <div class="project-meta">
                <span class="status-badge">
                  <span class="status-dot" style={`background: ${st.dot}`} />
                  {st.label}
                </span>
                <span class="proj-year">{p.year}</span>
              </div>

              <h3 class="project-title project-title--featured">{p.title}</h3>
              <p class="project-desc">{p.description}</p>

              <div class="project-actions">
                {p.links.live && (
                  <a
                    href={p.links.live}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary btn-sm"
                    onclick="event.stopPropagation()"
                  >
                    {i18n.PROYECTS.VIEW_PROJECT}
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 14 14"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M2 7h10M8 3l4 4-4 4"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </a>
                )}
                {p.links.code && (
                  <a
                    href={p.links.code}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-secondary btn-sm"
                    onclick="event.stopPropagation()"
                  >
                    GitHub
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>

  <!-- ── SECONDARY GRID ────────────────────────────────────────────── -->
  <div class="projects-grid projects-grid--secondary">
    {
      secondaryProjects.map((p, i) => {
        const st = statusConfig[p.status];
        return (
          <article
            class="project-card scroll-reveal"
            style={`--delay: ${0.05 + i * 0.07}s`}
          >
            <div
              class="project-img-wrap"
              data-project-id={p.id}
              role="button"
              tabindex="0"
              aria-label={`Ver detalles de ${p.title}`}
            >
              <img
                src={p.image}
                alt={p.imageAlt}
                class="project-img"
              />
              <div class="project-overlay" aria-hidden="true">
                <span class="overlay-cta">{i18n.PROYECTS.VIEW_DETAILS} →</span>
              </div>
            </div>

            <div class="project-body">
              <div class="project-meta">
                <span class="status-badge status-badge--sm">
                  <span class="status-dot" style={`background: ${st.dot}`} />
                  {st.label}
                </span>
                <span class="proj-year proj-year--sm">{p.year}</span>
              </div>

              <h3 class="project-title">{p.title}</h3>
              <p class="project-desc">{p.description}</p>

              <div class="project-actions">
                {p.links.live && (
                  <a
                    href={p.links.live}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary btn-sm"
                  >
                    {i18n.PROYECTS.VIEW_PROJECT}
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 14 14"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M2 7h10M8 3l4 4-4 4"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </a>
                )}
                {p.links.code && (
                  <a
                    href={p.links.code}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-secondary btn-sm"
                  >
                    GitHub
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</Section>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap");

  /* ── SECTION ───────────────────────────────────────────────────────── */
  :global(.proyects-section) {
    background: var(--color-bg-section);
  }

  .section-overline {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: var(--text-size-xxs);
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--spacing-md);
  }

  .section-overline::before {
    content: "";
    display: inline-block;
    width: 20px;
    height: var(--border-accent);
    background: var(--color-primary);
    border-radius: 1px;
  }

  /* ── GRIDS ─────────────────────────────────────────────────────────── */
  .projects-grid {
    display: grid;
    gap: var(--spacing-xl);
  }

  .projects-grid--featured {
    margin-bottom: var(--spacing-4xl);
  }

  @media (min-width: 1024px) {
    .projects-grid--featured {
      grid-template-columns: 1fr 1fr;
    }
  }

  .projects-grid--secondary {
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }

  @media (min-width: 640px) {
    .projects-grid--secondary {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid--secondary {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ── CARD BASE ─────────────────────────────────────────────────────── */
  .project-card {
    background: var(--color-bg-white);
    border: var(--border-thin) solid var(--color-border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform var(--transition-normal),
      box-shadow var(--transition-normal),
      border-color var(--transition-normal);
  }

  .project-card:has(.project-img-wrap:hover) {
    border-color: var(--color-border-primary);
    box-shadow: 0 12px 32px rgba(0, 74, 173, 0.1);
  }

  /* ── IMAGE WRAP ────────────────────────────────────────────────────── */
  .project-img-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16/9;
    cursor: pointer;
    transition: transform var(--transition-normal);
  }

  .project-img-wrap:hover {
    transform: translateY(-4px);
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .project-img-wrap:hover .project-img {
    transform: scale(1.04);
  }

  .project-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.75), transparent);
    opacity: 0;
    display: flex;
    align-items: flex-end;
    padding: var(--spacing-lg);
    transition: opacity var(--transition-slower);
  }

  .project-img-wrap:hover .project-overlay {
    opacity: 1;
  }

  .overlay-cta {
    color: white;
    font-size: var(--text-size-small);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.05em;
  }

  /* ── CARD BODY ─────────────────────────────────────────────────────── */
  .project-body {
    padding: var(--spacing-md) var(--spacing-lg);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-card--featured .project-body {
    padding: var(--spacing-lg) var(--spacing-xl) var(--spacing-xl);
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xs);
  }

  .project-title {
    font-size: var(--text-size-body);
    font-weight: var(--weight-bold);
    color: var(--color-text-dark);
    margin-bottom: var(--spacing-xs);
  }

  .project-title--featured {
    font-size: var(--text-size-h3);
  }

  .project-desc {
    font-size: var(--text-size-small);
    color: var(--color-text-muted);
    line-height: var(--line-height-normal);
    margin-bottom: var(--spacing-sm);
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .proj-year {
    font-size: var(--text-size-xs);
    color: var(--color-text-muted);
    font-weight: var(--weight-medium);
    opacity: 0.85;
  }

  .proj-year--sm {
    font-size: 11px;
  }

  .project-actions {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    margin-top: auto;
    padding-top: var(--spacing-md);
    flex-wrap: wrap;
  }

  /* ── SHARED: STATUS BADGE ──────────────────────────────────────────── */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: #5f5e5a;
    background: #f7f7f5;
    border: 0.5px solid #e8e6e0;
    padding: 3px 8px;
    border-radius: 20px;
  }

  .status-badge--sm {
    font-size: 10px;
    padding: 2px 7px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ── SHARED: BUTTONS ───────────────────────────────────────────────── */
  .btn-detail {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--color-primary-dark);
    color: var(--color-bg-white);
    font-size: 13px;
    font-weight: 500;
    padding: 8px 18px;
    border-radius: 7px;
    border: none;
    cursor: pointer;
    transition:
      background var(--transition-normal),
      transform var(--transition-fast);
    font-family: var(--font-sans);
  }

  .btn-detail:hover {
    background: var(--color-primary);
    transform: translateY(-1px);
  }

  .btn-ghost-sm {
    display: inline-flex;
    align-items: center;
    font-size: 13px;
    font-weight: 500;
    padding: 8px 14px;
    border-radius: 7px;
    border: var(--border-thin) solid var(--color-border-default);
    color: var(--color-text-tertiary);
    text-decoration: none;
    transition:
      border-color var(--transition-normal),
      color var(--transition-normal);
  }

  .btn-ghost-sm:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .btn-primary-sm {
    font-size: 12px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 6px;
    background: var(--color-primary-dark);
    color: var(--color-bg-white);
    text-decoration: none;
    transition: background var(--transition-normal);
  }

  .btn-primary-sm:hover {
    background: var(--color-primary);
  }

  .btn-outline-sm {
    font-size: 12px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 6px;
    border: var(--border-thin) solid var(--color-border-default);
    color: var(--color-text-tertiary);
    text-decoration: none;
    transition:
      border-color var(--transition-normal),
      color var(--transition-normal);
  }

  .btn-outline-sm:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* ── SCROLL REVEAL ─────────────────────────────────────────────────── */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.5s ease-out,
      transform 0.5s ease-out;
    transition-delay: var(--delay, 0s);
  }

  .scroll-reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script define:vars={{ projects }}>
  // ── SCROLL REVEAL ────────────────────────────────────────────────────────
  const revealEls = document.querySelectorAll("#proyects .scroll-reveal");
  const revealObs = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add("visible");
          revealObs.unobserve(e.target);
        }
      }),
    { threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
  );
  revealEls.forEach((el) => revealObs.observe(el));

  // ── DISPARAR EVENTO HACIA LA MODAL ──────────────────────────────────────
  document.querySelectorAll("[data-project-id]").forEach((el) => {
    el.addEventListener("click", (e) => {
      if (e.target.closest("a")) return;
      const projectId = el.dataset.projectId;
      const project = projects.find((x) => x.id === projectId);
      if (!project) return;
      document.dispatchEvent(
        new CustomEvent("open-project-modal", { detail: { project } }),
      );
    });
    el.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        const projectId = el.dataset.projectId;
        const project = projects.find((x) => x.id === projectId);
        if (!project) return;
        document.dispatchEvent(
          new CustomEvent("open-project-modal", { detail: { project } }),
        );
      }
    });
  });
</script>
