---
import Section from "@/components/Section.astro";
import LinkedInIcon from "@/Icons/LinkedInIcon.astro";
import GithubIcon from "@/Icons/GithubIcon.astro";
import SocialIcon from "@/components/SocialIcons.astro";
import { getI18n } from "@/i18n";

const { currentLocale } = Astro;
const i18n = getI18n({ currentLocale });
---

<Section id="hero" class="hero-section" applyMargin={false}>
  <!-- Ambient video background -->
  <div class="hero-video-bg" aria-hidden="true">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      disablepictureinpicture
      aria-hidden="true"
    >
      <source src="/assets/background/background_vid.webm" type="video/webm" />
    </video>
  </div>

  <!-- Blue accent line at the very top -->
  <div class="hero-top-accent" aria-hidden="true"></div>

  <div class="hero-inner">
    <!-- ── LEFT COLUMN ─────────────────────────────── -->
    <div class="hero-content">
      <!-- Greeting — italic serif, muted color -->
      <p
        class="text-subtitle-serif-italic hero-role animate-fade-up"
        style="--delay: 0.1s"
      >
        {i18n.HERO.GREETING}
      </p>

      <!-- H1: name — gradient + shine animation, defined in globals -->
      <h1
        class="text-name text-gradient text-gradient-animated hero-name animate-fade-up"
        style="--delay: 0.2s"
      >
        Marlon Mora
      </h1>

      <!-- Description -->
      <h2
        class="text-description hero-description animate-fade-up"
        style="--delay: 0.35s"
      >
        {i18n.HERO.DESCRIPTION}
      </h2>

      <!-- CTA row -->
      <div class="hero-actions animate-fade-up" style="--delay: 0.5s">
        <a href="#proyects" class="btn btn-primary">
          {i18n.HERO.CTA_TEXT}
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>

        <a href="#contact" class="btn btn-secondary">
          {i18n.HERO.SECONDARY_CTA}
        </a>
      </div>
    </div>

    <!-- ── RIGHT COLUMN: photo + overlays ────────────── -->
    <div class="hero-photo-wrapper animate-fade-up" style="--delay: 0.4s">
      <!-- Availability badge -->
      <div
        class="hero-availability-badge text-badge"
        aria-label={i18n.HERO.OVERLINE}
      >
        <span class="badge-dot" aria-hidden="true"></span>
        <span class="badge-text badge-text-mobile">{i18n.HERO.OVERLINE_MOBILE}</span>
        <span class="badge-text badge-text-desktop">{i18n.HERO.OVERLINE}</span>
      </div>

      <!-- Social icons: vertical stack -->
      <nav class="hero-social-stack" aria-label="Redes sociales">
        <SocialIcon
          href="https://www.linkedin.com/in/marlonmora/"
          class="social-link"
          title="LinkedIn"
        >
          <LinkedInIcon class="size-5" />
        </SocialIcon>

        <SocialIcon
          href="https://github.com/MarlonMora23"
          class="social-link"
          title="GitHub"
        >
          <GithubIcon class="size-5" />
        </SocialIcon>
      </nav>

      <figure class="hero-figure">
        <img
          class="hero-img"
          src="/assets/profile/MarlonMoraPhoto.webp"
          alt="Marlon Mora"
          loading="eager"
        />
      </figure>
    </div>
  </div>
</Section>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&display=swap");

  /* ── SECTION ───────────────────────────────────────────────────────────── */
  /* Background and overflow are hero-specific; everything else is global */
  :global(.hero-section) {
    position: relative;
    background: var(--gradient-hero-bg);
    overflow: hidden;
    padding-top: var(--spacing-7xl);
    padding-bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    margin-bottom: 0;
  }

  /* ── VIDEO BACKGROUND ──────────────────────────────────────────────────── */
  .hero-video-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .hero-video-bg video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.1;
  }

  /* ── TOP ACCENT LINE ───────────────────────────────────────────────────── */
  .hero-top-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: var(--border-accent);
    background: var(--gradient-top-accent);
    z-index: 1;
    pointer-events: none;
  }

  /* ── INNER LAYOUT ──────────────────────────────────────────────────────── */
  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-8xl);
    padding: var(--spacing-xl);
    width: 100%;
    margin: 0 auto;
  }

  @media (min-width: 1200px) {
    .hero-inner {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--spacing-5xl);
      padding: var(--spacing-9xl) 0 var(--spacing-2xl);
    }
  }

  /* ── LEFT COLUMN ───────────────────────────────────────────────────────── */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 540px;
  }

  @media (min-width: 1200px) {
    .hero-content {
      align-items: flex-start;
      padding-bottom: var(--spacing-2xl);
    }
  }

  /* Positioning / spacing overrides for text elements inside the hero */
  .hero-role {
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-xs);
    text-align: center;
  }

  @media (min-width: 1200px) {
    .hero-role {
      text-align: left;
    }
  }

  .hero-name {
    /* line-height override: Agraham has tall ascenders/descenders that need extra room */
    /* Do not use height: fit-content — it clips the font's visual overflow */
    line-height: 1.5;
    margin-bottom: var(--spacing-xl);
    text-align: center;
    font-variant-ligatures: common-ligatures contextual-ligatures;
    font-feature-settings:
      "liga" 1,
      "calt" 1;
  }

  @media (min-width: 1200px) {
    .hero-name {
      text-align: left;
    }
  }

  .hero-description {
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-xl);
    text-align: center;
    max-width: 480px;
  }

  @media (min-width: 1200px) {
    .hero-description {
      text-align: left;
    }
  }

  /* ── ACTIONS ROW ───────────────────────────────────────────────────────── */
  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    justify-content: center;
  }

  @media (min-width: 1200px) {
    .hero-actions {
      justify-content: flex-start;
    }
  }

  /* Lift effect on hover — hero buttons get a subtle translateY */
  .hero-actions .btn:hover {
    transform: translateY(-1px);
  }

  /* ── RIGHT COLUMN: PHOTO WRAPPER ───────────────────────────────────────── */
  .hero-photo-wrapper {
    position: relative;
    flex-shrink: 0;
    align-self: center;
    display: flex;
    justify-content: center;
    width: 100%;
    max-width: 400px;
    z-index: 1;
    margin: calc(-1 * var(--spacing-4xl)) calc(-1 * var(--spacing-md))
      calc(-1 * var(--spacing-2xl)) calc(-1 * var(--spacing-md));
  }

  @media (min-width: 768px) {
    .hero-photo-wrapper {
      max-width: 500px;
    }
  }

  @media (min-width: 1200px) {
    .hero-photo-wrapper {
      align-self: flex-end;
      max-width: 530px;
    }
  }

  /* ── AVAILABILITY BADGE ────────────────────────────────────────────────── */
  /* Layout and color are hero-specific; typography uses .text-badge global */
  .hero-availability-badge {
    position: absolute;
    top: 0px;
    right: -12px;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--color-success-bg);
    color: var(--color-success-text);
    padding: 7px 14px 7px 10px;
    border-radius: var(--radius-full);
    border: var(--border-default) solid var(--color-border-success);
    box-shadow: var(--shadow-success);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-8px);
    animation: badgeSlideIn var(--duration-badge-in) ease-out 0.65s forwards;
  }

  .badge-text-mobile {
    display: inline;
  }

  .badge-text-desktop {
    display: none;
  }

  @media (min-width: 480px) {
    .hero-availability-badge {
      display: flex;

    }

    .badge-text-mobile {
      display: none;
    }

    .badge-text-desktop {
      display: inline;
    }
  }

  @media (min-width: 1200px) {
    .hero-availability-badge {
      top: 0;
      right: 0;
      font-size: var(--text-size-small);
    }
  }

  /* Pulsing dot — uses pulse-ring keyframe from globals */
  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
    flex-shrink: 0;
    position: relative;
  }

  .badge-dot::after {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: var(--color-success);
    opacity: 0.35;
    animation: pulse-ring var(--duration-pulse) ease-out infinite;
  }

  /* ── SOCIAL STACK ──────────────────────────────────────────────────────── */
  /* .social-link styles are in global.css — only positioning is local */
  .hero-social-stack {
    position: absolute;
    left: -52px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    display: none;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  @media (min-width: 1200px) {
    .hero-social-stack {
      display: flex;
    }
  }

  /* ── PHOTO ─────────────────────────────────────────────────────────────── */
  .hero-figure {
    margin: 0;
    display: flex;
    width: 100%;
  }

  .hero-img {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(var(--shadow-photo));
  }

  /* ── REDUCED MOTION ────────────────────────────────────────────────────── */
  /* .animate-fade-up and .text-gradient-animated are handled in global.css  */
  @media (prefers-reduced-motion: reduce) {
    .hero-availability-badge {
      animation: none;
      opacity: 1;
      transform: none;
    }
    .badge-dot::after {
      animation: none;
    }
  }
</style>
