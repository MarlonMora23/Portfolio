---
import { getI18n } from "@/i18n";

const { currentLocale } = Astro;
const i18n = getI18n({ currentLocale });
---

<div class="stats-bridge" aria-label="Estadísticas">
    <div class="stats-bridge-inner">

        <div class="bridge-stat">
            <span class="bridge-number">3+</span>
            <span class="bridge-label">{i18n.HERO.STAT_1_LABEL}</span>
        </div>

        <div class="bridge-divider" aria-hidden="true"></div>

        <div class="bridge-stat">
            <span class="bridge-number">2</span>
            <span class="bridge-label">{i18n.HERO.STAT_2_LABEL}</span>
        </div>

        <div class="bridge-divider" aria-hidden="true"></div>

        <div class="bridge-stat">
            <span class="bridge-number">6+</span>
            <span class="bridge-label">{i18n.HERO.STAT_3_LABEL}</span>
        </div>

        <div class="bridge-divider" aria-hidden="true"></div>

        <div class="bridge-stat">
            <span class="bridge-number">∞</span>
            <span class="bridge-label">{i18n.HERO.STAT_4_LABEL}</span>
        </div>

    </div>
</div>

<style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&display=swap');

    .stats-bridge {
        width: 100%;
        background: #ffffff;
        border-top: 0.5px solid #E8E6E0;
        border-bottom: 0.5px solid #E8E6E0;
        position: relative;
        z-index: 2;
    }

    .stats-bridge-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 48px;
    }

    .bridge-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        padding: 24px 40px;
        flex: 1;
    }

    @media (min-width: 1024px) {
        .bridge-stat {
            flex: 0 0 auto;
        }
    }

    .bridge-number {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(26px, 3vw, 36px);
        font-weight: 700;
        color: #004aad;
        line-height: 1;
    }

    .bridge-label {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #888780;
        white-space: nowrap;
    }

    .bridge-divider {
        width: 0.5px;
        height: 36px;
        background: #E8E6E0;
        flex-shrink: 0;
    }

    /* Scroll reveal */
    .stats-bridge {
        opacity: 0;
        transform: translateY(12px);
        transition: opacity 0.5s ease-out, transform 0.5s ease-out;
    }

    .stats-bridge.visible {
        opacity: 1;
        transform: translateY(0);
    }

    @media (prefers-reduced-motion: reduce) {
        .stats-bridge {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }
</style>

<script>
    const bridge = document.querySelector('.stats-bridge');
    if (bridge) {
        const observer = new IntersectionObserver(
            ([entry]) => {
                if (entry.isIntersecting) {
                    bridge.classList.add('visible');
                    observer.disconnect();
                }
            },
            { threshold: 0.2 }
        );
        observer.observe(bridge);
    }
</script>